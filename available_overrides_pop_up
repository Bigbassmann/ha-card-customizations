type: vertical-stack
cards:
  - type: custom:bubble-card
    card_type: pop-up
    name: " Active"
    icon: ""
    hash: "#available-overrides"
    button_type: state
    trigger_close: false
    close_by_clicking_outside: true
    scrolling_effect: false
    close_on_click: true
    button_action: {}
    sub_button:
      - entity: sensor.active_automation_overrides
        name: Show Active
        state_background: true
        show_background: true
        show_name: true
        show_attribute: false
        tap_action:
          action: navigate
          navigation_path: "#active-overrides"
        show_state: false
    show_header: true
    entity: sensor.active_automation_overrides
    show_attribute: true
    attribute: category_counts
    show_last_updated: false
    show_state: true
    show_icon: true
    hide_backdrop: false
    card_layout: large
    force_icon: false
    show_name: true
  - square: false
    type: grid
    cards:
      - type: custom:auto-entities
        show_name: true
        card:
          type: entities
        filter:
          include:
            - options: {}
              label: overrides_special
              domain: lock
              state: locked
            - options: {}
              domain: lock
              label: overrides_special
              state: locked
              attributes:
                monitored_override: true
            - options: {}
              label: overrides_special
              domain: input_boolean
              state: "off"
              attributes:
                monitored_override: false
            - options: {}
              domain: input_boolean
              label: overrides_special
              state: "off"
              attributes:
                monitored_override: true
            - type: section
            - options: {}
              domain: input_boolean
              state: "off"
              attributes:
                monitored_override: true
                override_category: Global
            - type: section
            - options: {}
              domain: input_boolean
              state: "off"
              attributes:
                monitored_override: true
                override_category: Area
            - type: section
            - options: {}
              domain: input_boolean
              state: "off"
              attributes:
                monitored_override: true
                override_category: Device
            - options: {}
            - options: {}
              entity_id: input_boolean.sleepnumber_disable_automations
              state: "off"
          exclude: []
        sort: name
    columns: 1
    title: Available Overrides
grid_options:
  columns: full
